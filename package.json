{
  "name": "modest-human-brands",
  "version": "0.10.22",
  "description": "The collaborative workflow management app built for creatives.",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modest-Human-Brands/modest-human-brands.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.11.0 || ^24.14.0",
    "pnpm": "^9.15.0 || ^10.2.0",
    "bun": "^1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test:load": "k6 run tests/load.test.ts",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node --env-file=.env.prod .output/server/index.mjs",
    "clean": "nuxt cleanup && (cd src-tauri && cargo clean)",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t modest-human-brands:dev .",
    "docker:start": "docker run --detach --name modest-human-brands-dev --env-file .env.prod -p 4000:3000 modest-human-brands:dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:mobile": "tauri android dev",
    "tauri:build:mobile": "tauri android build"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@notionhq/client": "^5.28.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.1",
    "@nuxt/image": "^2.2.0",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/mcp-toolkit": "^0.24.2",
    "@nuxtjs/seo": "^6.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.3",
    "@regle/nuxt": "^1.29.5",
    "@tato30/vue-pdf": "^2.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/extension-drag-handle-vue-3": "^3.32.0",
    "@tiptap/extension-history": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@types/web-push": "^3.6.4",
    "@unhead/vue": "^3.4.3",
    "@videojs/dash-video": "^10.2.0",
    "@videojs/hlsjs-video": "^10.2.0",
    "@videojs/html": "^10.2.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "defu": "^6.1.7",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "matrix-js-sdk": "^44.0.0",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "^0.5.32",
    "nuxt-tiptap-editor": "3.4.0",
    "p-retry": "^8.0.1",
    "p-throttle": "^8.1.1",
    "tinygradient": "^2.0.1",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dotenvx/dotenvx": "^2.38.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/k6": "^2.3.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi"
  ]
}
